# Stuff we don't want to copy into the Docker image.
# Keeps the image small and rebuilds fast.

# VCS + CI
.git
.github
.gitignore

# Env (Railway injects its own)
.env
.env.example

# Re-installed inside the image
vendor
node_modules
# NOTE: public/build is NOT ignored — Vite generates it during the image
# build (RUN pnpm run build) and we need it in the final image so Laravel
# can serve the compiled CSS/JS.

# IDE / OS noise
.vscode
.idea
.DS_Store

# Tests don't belong in production images
tests

# Docs are for humans, not containers
*.md
docs

# Docker self-references
Dockerfile
.dockerignore
