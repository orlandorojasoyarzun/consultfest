APP_NAME=Consultfest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://consultfest.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail driver:
#   - "log"   → writes notifications to storage/logs/laravel.log. Default for dev
#               when no SMTP creds are set up.
#   - "smtp"  → real delivery. Use smtp.gmail.com (with a 16-char Gmail App
#               Password, NOT your account password) during dev/demo. Set
#               MAIL_USERNAME to your Gmail address and MAIL_PASSWORD to the
#               App Password from https://myaccount.google.com/apppasswords
#               (requires 2-Step Verification enabled).
#   - "resend" → production. Requires RESEND_API_KEY below AND a verified domain
#               in https://resend.com/domains. Until then, every notification
#               goes to failed_jobs with a "domain is not verified" error.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Sender identity while the product is still in flux. These point at a
# personal Gmail until Consultfest's domain + final brand are locked in.
# Once you own consultfest.com and have it verified on Resend, switch to
# MAIL_FROM_ADDRESS="hello@consultfest.com" and MAIL_FROM_NAME="Consultfest"
# (and flip MAIL_MAILER to resend).
MAIL_FROM_ADDRESS="orlandorojasoyarzun@gmail.com"
MAIL_FROM_NAME="Orlando desde Consultfest"

# Google OAuth 2 (Socialite)
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Festival API (https://festivalapi.com)
# Bearer token used for live festival search. Get one from
# https://festivalapi.com/dashboard/api-keys/ — pay-as-you-go, 1 credit
# per search. Without this key the search view falls back to the local
# factory-seeded dataset (dev only).
FESTIVAL_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
